msgstr "Συμπληρώστε όλα τα πεδία είτε της σύνδεσης είτε της φόρμας εγγραφής."

#: pretalx/person/interfaces/forms/auth.py
msgid ""
"No user account matches the entered credentials. Are you sure that you typed "
"your password correctly?"
msgstr ""
"Δεν υπάρχει λογαριασμός που να ταιριάζει με τα στοιχεία σας. Βεβαιωθήκατε "
"ότι πληκτρολογήσατε σωστά τον κωδικό πρόσβασης;"

#: pretalx/person/interfaces/forms/auth.py
msgid "Sorry, your account is currently disabled."
msgstr "Λυπούμαστε, ο λογαριασμός σας είναι απενεργοποιημένος προς το παρόν."

#: pretalx/person/interfaces/forms/auth.py
msgid ""
"We already have a user with that email address. Did you already register "
"before and just need to log in?"
msgstr ""
"Έχουμε ήδη ένα χρήστη με αυτή την διεύθυνση email. Εγγραφήκατε ήδη πριν και "
"θέλετε απλά να συνδεθείτε;"

#: pretalx/person/interfaces/forms/auth_token.py
msgid "Select all events"
msgstr "Επιλογή όλων των εκδηλώσεων"

#: pretalx/person/interfaces/forms/auth_token.py
msgid "Customise permissions and endpoints"
msgstr "Δικαιώματα"

#: pretalx/person/interfaces/forms/auth_token.py
msgid "Choose a preset or configure detailed permissions below."
msgstr ""
"Επιλέξτε προκαθορισμένο σύνολο δικαιωμάτων ή ρυθμίστε αναλυτικά τα "
"δικαιώματα παρακάτω."

#: pretalx/person/interfaces/forms/filters.py
msgid "Non-accepted submitters"
msgstr "Μη-αποδεκτοί αιτούντες"

#: pretalx/person/interfaces/forms/filters.py
msgid "Submitters and speakers"
msgstr "Υποβάλλοντες προτάσεις και ομιλητές"

#: pretalx/person/interfaces/forms/filters.py
msgid "Any arrival status"
msgstr "Οποιαδήποτε κατάσταση άφιξης"

#: pretalx/person/interfaces/forms/filters.py
msgid "Marked as arrived"
msgstr "Επισημάνθηκε ως αφιχθείς"

#: pretalx/person/interfaces/forms/filters.py
msgid "Not yet arrived"
msgstr "Δεν έχει φτάσει ακόμη"

#: pretalx/person/interfaces/forms/filters.py
#: pretalx/submission/interfaces/forms/submission.py
msgid "Full text search"
msgstr "Αναζήτηση πλήρους κειμένου"

#: pretalx/person/models/auth_token.py
msgid "Valid for all events you have access to (including newly created ones)"
msgstr ""
"Ισχύει για όλες τις εκδηλώσεις στις οποίες έχετε πρόσβαση (και για όσες "
"δημιουργηθούν στο μέλλον)"

#: pretalx/person/models/auth_token.py
msgid "Expiry date"
msgstr "Ημερομηνία λήξης"

#: pretalx/person/models/auth_token.py
msgid "API version"
msgstr "Έκδοση API"

#: pretalx/person/models/auth_token.py
msgid "Please select at least one endpoint permission."
msgstr "Επιλέξτε τουλάχιστον ένα δικαίωμα πρόσβασης σε τελικό σημείο API."

#: pretalx/person/models/information.py
msgid "All accepted speakers"
msgstr "Όλοι δεκτοί ομιλητές"

#: pretalx/person/models/information.py
msgid "Only confirmed speakers"
msgstr "Μόνο επιβεβαιωμένα ηχεία"

#: pretalx/person/models/information.py
msgid "Leave empty to show this information to all tracks."
msgstr ""
"Αφήστε κενό για να εμφανιστούν αυτές οι πληροφορίες σε όλα τα κομμάτια."

#: pretalx/person/models/information.py
msgid "Limit to proposal types"
msgstr "Περιορισμός στους τύπους προτάσεων"

#: pretalx/person/models/information.py
msgid "Leave empty to show this information for all proposal types."
msgstr ""
"Αφήστε κενό για να εμφανιστούν αυτές οι πληροφορίες για όλους τους τύπους "
"προτάσεων."

#: pretalx/person/models/information.py
msgid "Please try to keep your upload small, preferably below 16 MB."
msgstr ""
"Παρακαλώ κρατήστε τις μεταφορτώσεις σας μικρές, κατά προτίμηση κάτω των 16 "
"MB."

#: pretalx/person/models/profile.py
msgid "The speaker has arrived"
msgstr "Ο ομιλητής έφτασε"

#: pretalx/person/models/profile.py
msgid "Unnamed speaker"
msgstr "Ομιλητής χωρίς όνομα"

#: pretalx/person/models/user.py
msgid "Your username must not contain HTML or other markup."
msgstr "Το όνομα χρήστη δεν πρέπει να περιέχει HTML ή άλλη σήμανση."

#: pretalx/person/models/user.py
msgid ""
"Please enter the name you wish to be displayed publicly. This name will be "
"used for all events you are participating in on this server."
msgstr ""
"Εισαγάγετε το όνομα που θέλετε να εμφανίζεται δημόσια. Αυτό το όνομα θα "
"χρησιμοποιηθεί για όλες τις εκδηλώσεις στις οποίες συμμετέχετε σε αυτόν τον "
"διακομιστή."

#: pretalx/person/models/user.py
msgid ""
"Your email address will be used for password resets and notification about "
"your event/proposals."
msgstr ""
"Η διεύθυνση email σας θα χρησιμοποιηθεί για επαναφορά κωδικού πρόσβασης και "
"ειδοποίηση σχετικά με την εκδήλωση ή τις προτάσεις σας."

#: pretalx/person/models/user.py
msgid "Preferred language"
msgstr "Προτειμώμενη γλώσσα"

#: pretalx/person/models/user.py pretalx/person/validators.py
msgid "Please choose a different email address."
msgstr "Επιλέξτε διαφορετική διεύθυνση email."

#: pretalx/person/models/user.py
msgid "Unnamed user"
msgstr "Ανώνυμος χρήστης"

#: pretalx/person/validators.py
msgid "There already exists an account for this email address."
msgstr "Υπάρχει ήδη λογαριασμός για αυτή τη διεύθυνση email."

#: pretalx/schedule/domain/warnings.py
#, python-brace-format
msgid "Room {room_name} is not available at the scheduled time."
msgstr "Το δωμάτιο {room_name} δεν είναι διαθέσιμο την προγραμματισμένη ώρα."

#: pretalx/schedule/domain/warnings.py
msgid "Another session in the same room overlaps with this one."
msgstr "Μια άλλη συνεδρία στην ίδια αίθουσα συμπίπτει με αυτήν."

#: pretalx/schedule/domain/warnings.py
#, python-brace-format
msgid "{speaker} is not available at the scheduled time."
msgstr "Ο/Η {speaker} δεν είναι διαθέσιμος/η την προγραμματισμένη ώρα."

#: pretalx/schedule/domain/warnings.py
#, python-brace-format
msgid "{speaker} is scheduled for another session at the same time."
msgstr ""
"Ο/Η {speaker} πραγματοποιεί μια άλλη συνεδρία την προγραμματισμένη ώρα."

#: pretalx/schedule/domain/warnings.py
#, python-brace-format
msgid ""
"Room {room_name} has less space ({room_cap}) than the session’s signup "
"capacity ({session_cap})."
msgstr ""
"Η αίθουσα {room_name} έχει λιγότερες θέσεις ({room_cap}) από τη χωρητικότητα "
"εγγραφών της συνεδρίας ({session_cap})."

#: pretalx/schedule/enums.py
msgid "Break"
msgstr "Διάλειμμα"

#: pretalx/schedule/enums.py
msgid "Blocker"
msgstr "Δέσμευση"

#: pretalx/schedule/interfaces/exporters.py
msgid "iCal (full event)"
msgstr "iCal (ολόκληρη η εκδήλωση)"

#: pretalx/schedule/interfaces/exporters.py
msgid "iCal (your starred sessions)"
msgstr "iCal (οι συνεδρίες που έχετε επισημάνει με αστέρι)"

#: pretalx/schedule/interfaces/forms/room.py
msgid ""
"Please click and drag to mark your availability during the conference with "
"green blocks. We will try to schedule your slot during these times. You can "
"click a block twice to remove it."
msgstr ""
"Κάντε κλικ και σύρετε για να επισημάνετε τη διαθεσιμότητά σας κατά τη "
"διάρκεια της διάσκεψης με πράσινα μπλοκ. Θα προσπαθήσουμε να "
"προγραμματίσουμε τη θέση σας κατά τη διάρκεια αυτών των ωρών. Μπορείτε να "
"κάνετε κλικ σε ένα μπλοκ δύο φορές για να το αφαιρέσετε."

#: pretalx/schedule/interfaces/forms/room.py
#, python-brace-format
msgid "All times are in the event timezone, {tz}."
msgstr "Όλες οι ώρες είναι στη ζώνη ώρας συμβάντος, {tz}."

#: pretalx/schedule/interfaces/forms/room.py
msgid ""
"If you set room availabilities, speakers will only be able to set their "
"availability for when any room is available."
msgstr ""
"Εάν ορίσετε διαθεσιμότητα αιθουσών, οι ομιλητές θα μπορούν να δηλώνουν "
"διαθεσιμότητα μόνο όταν είναι διαθέσιμη τουλάχιστον μία αίθουσα."

#: pretalx/schedule/interfaces/forms/room.py
msgid "Room I"
msgstr "Αίθουσα Ι"

#: pretalx/schedule/interfaces/forms/room.py
msgid ""
"Description, e.g.: Our main meeting place, Room I, enter from the right."
msgstr ""
"Περιγραφή, π.χ.: Το κύριο σημείο συνάντησής μας, Αίθουσα Ι, είσοδος από "
"αριστερά."

#: pretalx/schedule/interfaces/forms/room.py
msgid "Information for speakers, e.g.: Projector has only HDMI input."
msgstr "Πληροφορίες για ομιλητές, π.χ.: Ο προτζέκτορας έχει μόνο είσοδο HDMI."

#: pretalx/schedule/interfaces/forms/room.py
#, python-brace-format
msgid "The current, automatically generated GUID is: {guid}."
msgstr "Το τρέχον, αυτόματα δημιουργημένο GUID είναι: {guid}."

#: pretalx/schedule/interfaces/forms/schedule.py
msgid "Notify speakers of changes"
msgstr "Ενημερώστε τους ομιλητές για αλλαγές"

#: pretalx/schedule/interfaces/forms/schedule.py
msgid "We released a new schedule version!"
msgstr "Κυκλοφορήσαμε μια νέα έκδοση προγράμματος!"

#: pretalx/schedule/interfaces/forms/schedule.py
#, python-brace-format
msgid "Expand “{title}” capacity to {capacity}"
msgstr "Αύξηση χωρητικότητας της συνεδρίας «{title}» σε {capacity}"

#: pretalx/schedule/interfaces/forms/widget.py
msgid "Show the widget even if the schedule is not public"
msgstr ""
"Εμφάνιση του γραφικού στοιχείου ακόμα κι αν το χρονοδιάγραμμα δεν είναι "
"δημόσιο"

#: pretalx/schedule/interfaces/forms/widget.py
msgid ""
"Set to allow external pages to show the schedule widget, even if the "
"schedule is not shown here using pretalx."
msgstr ""
"Ρυθμίστε ώστε να επιτρέπεται στις εξωτερικές σελίδες να εμφανίζουν το "
"γραφικό στοιχείο χρονοδιαγράμματος, ακόμα κι αν το πρόγραμμα δεν εμφανίζεται "
"εδώ χρησιμοποιώντας το pretalx."

#: pretalx/schedule/interfaces/forms/widget.py
msgid "Limit days"
msgstr "Περιορισμός ημερών"

#: pretalx/schedule/interfaces/forms/widget.py
msgid ""
"You can limit the days shown in the widget. Leave empty to show all days."
msgstr ""
"Μπορείτε να περιορίσετε τις ημέρες που εμφανίζονται στο γραφικό στοιχείο. "
"Αφήστε κενό για όλες τις ημέρες."

#: pretalx/schedule/interfaces/forms/widget.py
msgid "Limit rooms"
msgstr "Περιορισμός αιθουσών"

#: pretalx/schedule/interfaces/forms/widget.py
msgid ""
"You can limit the rooms shown in the widget. Leave empty to show all rooms."
msgstr ""
"Μπορείτε να περιορίσετε τις αίθουσες που εμφανίζονται στο γραφικό στοιχείο. "
"Αφήστε κενό για όλες τις αίθουσες."

#: pretalx/schedule/interfaces/forms/widget.py
msgid "Widget language"
msgstr "Γλώσσα widget"

#: pretalx/schedule/models/room.py
msgid "GUID"
msgstr "ΟΔΗΓΟΣ"

#: pretalx/schedule/models/room.py
msgid "Unique identifier (UUID) to help external tools identify the room."
msgstr ""
"Μοναδικό αναγνωριστικό (UUID) που βοηθά τα εξωτερικά εργαλεία να "
"αναγνωρίζουν το δωμάτιο."

#: pretalx/schedule/models/room.py
msgid "A description for attendees, for example directions."
msgstr "Μια περιγραφή για το ακροατήριο, π.χ. οδηγίες."

#: pretalx/schedule/models/room.py
msgid ""
"Information relevant for speakers scheduled in this room, for example room "
"size, special directions, available adaptors for video input …"
msgstr ""
"Πληροφορίες σχετικές για ηχεία που έχουν προγραμματιστεί σε αυτό το δωμάτιο, "
"για παράδειγμα μέγεθος δωματίου, ειδικές οδηγίες, διαθέσιμοι προσαρμογείς "
"για είσοδο βίντεο…"

#: pretalx/schedule/models/room.py
msgid "Capacity"
msgstr "Χωρητικότητα"

#: pretalx/schedule/models/room.py
msgid "How many people can fit in the room?"
msgstr "Πόσα άτομα μπορούν να χωρέσουν σ' αυτή την αίθουσα;"

#: pretalx/schedule/models/schedule.py pretalx/schedule/phrases.py
msgctxt "Version of the conference schedule"
msgid "Version"
msgstr "Έκδοση"

#: pretalx/schedule/models/schedule.py
msgid "This text will be shown in the public changelog and the RSS feed."
msgstr ""
"Αυτό το κείμενο θα εμφανίζεται στο δημόσιο αρχείο καταγραφής αλλαγών και στη "
"ροή RSS."

#: pretalx/schedule/models/slot.py
msgid "The room this session is scheduled in, if any"
msgstr "Η αίθουσα στην οποία έχει προγραμματιστεί αυτή η ομιλία, εάν υπάρχει"

#: pretalx/schedule/models/slot.py
msgid "Slot type"
msgstr "Τύπος χρονικής θέσης"

#: pretalx/schedule/models/slot.py
msgid ""
"For non-submission slots: 'break' for public breaks, 'blocker' for hidden "
"blockers"
msgstr ""
"Για χρονικές θέσεις εκτός προτάσεων: 'break' για δημόσια διαλείμματα, "
"'blocker' για κρυφές δεσμεύσεις"

#: pretalx/schedule/models/slot.py
msgid "Start"
msgstr "Αρχή"

#: pretalx/schedule/models/slot.py
msgid "When the session starts, if it is currently scheduled"
msgstr "Όταν ξεκινήσει η συζήτηση, εάν είναι προγραμματισμένη αυτή τη στιγμή"

#: pretalx/schedule/models/slot.py
msgid "End"
msgstr "Τέλος"

#: pretalx/schedule/models/slot.py
msgid "When the session ends, if it is currently scheduled"
msgstr "Όταν τελειώσει η ομιλία, αν είναι προγραμματισμένη αυτή τη στιγμή"

#: pretalx/schedule/phrases.py
msgid "We released our first schedule!"
msgstr "Ανακοινώθηκε μια πρώτη έκδοση του προγράμματος!"

#: pretalx/schedule/phrases.py
msgid ""
"You are currently viewing the editable schedule version, which is unreleased "
"and may change at any time."
msgstr ""
"Για την ώρα βλέπετε μια προσωρινή έκδοση του προγράμματος, που δεν έχει "
"εκδοθεί κι ενδέχεται ν' αλλάξει."

#: pretalx/schedule/phrases.py
msgid "You are currently viewing an older schedule version."
msgstr "Αυτήν τη στιγμή βλέπετε μια παλαιότερη έκδοση χρονοδιαγράμματος."

#: pretalx/schedule/phrases.py
#, python-format
msgid "You can find the current version <a href=\"%(current_url)s\">here</a>."
msgstr ""
"Μπορείτε να βρείτε την τρέχουσα έκδοση <a href=\"%(current_url)s\">εδώ</a>."

#. Translators: “tz” is a full timezone name like “Europe/Berlin”
#: pretalx/schedule/phrases.py
#, python-format
msgid "All times in %(tz)s"
msgstr "Όλοι οι χρόνοι σε %(tz)s"

#: pretalx/schedule/phrases.py
msgid "The speaker's profile picture"
msgstr "Η εικόνα προφίλ του ομιλητή"

#: pretalx/schedule/templates/schedule/speaker_notification.txt
#, python-format
msgid "- Your session “%(title)s” will take place at %(start)s in %(location)s"
msgstr ""
"- Η συνεδρία σας \"%(title)s\" θα πραγματοποιηθεί στο %(start)s σε "
"%(location)s"

#: pretalx/schedule/templates/schedule/speaker_notification.txt
#, python-format
msgid "- Your session “%(title)s” has been moved to %(start)s in %(location)s"
msgstr ""
"- Η συνεδρία σας \"%(title)s\" έχει μετακινηθεί στο %(start)s σε %(location)s"

#: pretalx/schedule/validators/schedule.py
msgid "This schedule version was used already, please choose a different one."
msgstr ""
"Αυτή η έκδοση χρονοδιαγράμματος χρησιμοποιήθηκε ήδη, επιλέξτε μια "
"διαφορετική."

#: pretalx/schedule/validators/slot.py
msgid "Scheduled times cannot be before the event starts."
msgstr ""
"Οι προγραμματισμένες ώρες δεν μπορούν να είναι πριν από την έναρξη της "
"εκδήλωσης."

#: pretalx/schedule/validators/slot.py
msgid "Scheduled times cannot be after the event ends."
msgstr ""
"Οι προγραμματισμένες ώρες δεν μπορούν να είναι μετά τη λήξη της εκδήλωσης."

#: pretalx/schedule/validators/slot.py
msgid "The end time has to be after the start time."
msgstr "Η ώρα λήξης πρέπει να είναι μετά την ώρα έναρξης."

