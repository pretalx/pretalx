msgstr "Αφήστε κενό για χρήση του προεπιλεγμένου τίτλου."

#: pretalx/orga/forms/cfp.py
msgid "Step description"
msgstr "Περιγραφή βήματος"

#: pretalx/orga/forms/cfp.py
msgid "Leave empty to use the default description."
msgstr "Αφήστε κενό για χρήση της προεπιλεγμένης περιγραφής."

