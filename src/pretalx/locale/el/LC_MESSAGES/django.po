msgstr "Έγραψες {count} λέξεις."

#: pretalx/cfp/forms.py
#, python-brace-format
msgid "Please select exactly {count} tags."
msgstr "Επιλέξτε ακριβώς {count} ετικέτες."

#: pretalx/cfp/forms.py
