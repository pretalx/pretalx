msgstr "Αυτό το ηχείο εμφανίζεται επίσης σε:"

#: pretalx/agenda/views/ascii.py
msgid "No speakers"
msgstr "Χωρίς ηχεία"

#: pretalx/agenda/views/schedule.py
msgid "Our schedule is not live yet."
msgstr "Το πρόγραμμά μας δεν είναι ακόμα ζωντανό."

#: pretalx/agenda/views/schedule.py
#: pretalx/cfp/templates/cfp/event/invitation.html
#: pretalx/event/domain/event.py pretalx/orga/templates/orga/cfp/editor.html
#: pretalx/submission/domain/submission.py
#: pretalx/submission/models/question.py
