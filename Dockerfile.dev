# Local development image, used by docker-compose.yml. Python + Node + uv;
# the source is bind-mounted, so code changes need no rebuild.
ARG PYTHON_VERSION=3.14
ARG NODE_VERSION=22

FROM node:${NODE_VERSION}-trixie-slim AS node

FROM python:${PYTHON_VERSION}-slim-trixie

COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
 && ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx
COPY --from=ghcr.io/astral-sh/uv:0.9 /uv /usr/local/bin/uv

RUN apt-get update \
 && apt-get install -y --no-install-recommends gettext \
 && rm -rf /var/lib/apt/lists/*

ENV PYTHONUNBUFFERED=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy \
    PATH=/opt/venv/bin:$PATH \
    PYTHONPATH=/app/src

WORKDIR /app
# Dependencies only; pretalx itself is imported from the mounted source.
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-install-project --extra dev --extra postgres

# Local plugins: every plugins/<name>/ with a pyproject.toml, installed
# editable, so the bind-mounted source at the same path is what runs and plugin
# code changes need no rebuild. Adding a plugin does need one (its entry point,
# which pretalx finds plugins by, is registered here). --no-deps: the plugins
# pin a released pretalx, but here pretalx is the mounted development source.
COPY plugins plugins
RUN for plugin in plugins/*/; do \
        if [ -f "$plugin/pyproject.toml" ]; then \
            uv pip install --python /opt/venv --no-deps --editable "$plugin" || exit 1; \
        fi; \
    done

COPY src/pretalx/frontend/package.json src/pretalx/frontend/package-lock.json src/pretalx/frontend/
RUN cd src/pretalx/frontend && npm ci

WORKDIR /app/src
